PORT=8080
NODE_ENV=development

# Option A: one connection string (Railway, Neon, local...)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskmanager

# Option B: separate values (on Cloud Run use DB_HOST=/cloudsql/PROJECT:REGION:INSTANCE)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=taskmanager

# Set to true if the database host requires SSL (e.g. a public database URL)
# DB_SSL=true

SESSION_SECRET=change-me-to-a-long-random-string
# Set to "memory" to skip the PostgreSQL session store in development
# SESSION_STORE=memory

# Max login/register attempts per IP per 15 minutes (default 100)
# AUTH_RATE_LIMIT_MAX=100
# Number of reverse proxies in front of the app (default 1)
# TRUST_PROXY=1

# Only used by `npm test`. This database is WIPED by the tests, never use a real one.
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskmanager_test
